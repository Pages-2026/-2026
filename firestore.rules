rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // الأدمن = من له مستند في admins/{uid} (يُنشأ يدوياً من Console فقط)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    match /admins/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['email', 'created_at', 'display_name'])
        && request.resource.data.email == request.auth.token.email
        && (!('display_name' in request.resource.data) || (request.resource.data.display_name is string && request.resource.data.display_name.size() <= 30));
      allow delete: if false;
    }

    match /stories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_purchases/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if isAdmin();
    }

    // التقييمات والتعليقات: القراءة للجميع، الكتابة لمن اشترى القصة فقط (تقييم واحد لكل قصة)
    match /reviews/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['story_id', 'user_id', 'name', 'rating', 'comment', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.story_id
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
        && exists(/databases/$(database)/documents/user_purchases/$(id));
      allow delete: if isAdmin() || owns(resource.data.user_id);
    }

    // الأجهزة: المستخدم يضيف فقط (حد أقصى 2) ولا يستطيع حذف جهاز؛ الأدمن يمسح.
    match /user_devices/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['devices'])
        && request.resource.data.devices.size() <= 5;
      allow update: if isAdmin() || (owns(uid)
        && request.resource.data.keys().hasOnly(['devices'])
        && request.resource.data.devices.size() <= 5
        && request.resource.data.devices.diff(resource.data.devices).removedKeys().size() == 0);
      allow delete: if isAdmin();
    }

    // أجزاء الـ PDF الكامل: قراءة مستند-مستند فقط، لمن اشترى القصة وله جهاز مسجل. لا list.
    match /pdf_chunks/{storyId}/parts/{n} {
      allow get: if isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/user_purchases/$(request.auth.uid + '_' + storyId))
        && exists(/databases/$(database)/documents/user_devices/$(request.auth.uid)));
      allow list: if false;
      allow write: if isAdmin();
    }

    // العينة المجانية (أول صفحات فقط): لأي مستخدم مسجل
    match /pdf_sample/{storyId}/parts/{n} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
